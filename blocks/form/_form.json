{
  "definitions": [
    {
      "title": "Form",
      "id": "form",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Form",
              "filter": "form"
            }
          }
        }
      }
    },
    {
      "title": "Form Settings",
      "id": "form-settings",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "FormSettings",
              "model": "form-settings",
              "formId": "enquiry",
              "submitMode": "rest",
              "submitUrl": "",
              "spreadsheetPath": "/content/eds-k/test/form"
            }
          }
        }
      }
    },
    {
      "title": "Form Field",
      "id": "form-field",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "FormField",
              "model": "form-field",
              "type": "text",
              "fieldName": "field",
              "label": "Field label"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "form-settings",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "formId",
          "label": "Form ID",
          "description": "Identifier included in the submission payload",
          "value": "enquiry"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "submitMode",
          "label": "Submit Type",
          "value": "rest",
          "options": [
            { "name": "REST API", "value": "rest" },
            { "name": "Spreadsheet", "value": "spreadsheet" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "submitUrl",
          "label": "Submit URL",
          "description": "REST endpoint or public spreadsheet proxy URL"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "spreadsheetPath",
          "label": "Spreadsheet Path",
          "description": "AEM Author spreadsheet path (spreadsheet submit type)",
          "value": "/content/eds-k/test/form"
        }
      ]
    },
    {
      "id": "form-field",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field Type",
          "value": "text",
          "options": [
            { "name": "Text", "value": "text" },
            { "name": "Email", "value": "email" },
            { "name": "Telephone", "value": "tel" },
            { "name": "Textarea", "value": "textarea" },
            { "name": "Radio", "value": "radio" },
            { "name": "Checkbox", "value": "checkbox" },
            { "name": "Dropdown", "value": "select" },
            { "name": "Date", "value": "date" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "fieldName",
          "label": "Field Name",
          "description": "Name in the submission payload; for spreadsheet submit must match the column header",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "required": true
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "options",
          "label": "Options / Settings",
          "description": "Optional lines: required | placeholder: text | help: text. Then one option per line for radio, checkbox, or select (value|Label or Label)."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "form",
      "components": [
        "form-settings",
        "form-field"
      ]
    }
  ]
}
