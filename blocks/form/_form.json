{
  "definitions": [
    {
      "title": "Form",
      "id": "form",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Form",
              "model": "form",
              "filter": "form",
              "submit_formId": "enquiry",
              "submit_mode": "rest",
              "submit_url": "",
              "submit_spreadsheetPath": "/content/eds-k/test/form",
              "ui_submitLabel": "Submit",
              "ui_successMessage": "Thank you. Your enquiry has been submitted.",
              "ui_errorMessage": "Sorry, something went wrong. Please try again."
            }
          }
        }
      }
    },
    {
      "title": "Form Field",
      "id": "form-field",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Form Field",
              "model": "form-field",
              "type": "text"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "form",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "submit_formId",
          "label": "Form ID",
          "description": "Identifier included in the submission payload",
          "value": "enquiry"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "submit_mode",
          "label": "Submit Type",
          "value": "rest",
          "options": [
            { "name": "REST API", "value": "rest" },
            { "name": "Spreadsheet", "value": "spreadsheet" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "submit_url",
          "label": "Submit URL",
          "description": "REST endpoint or public spreadsheet proxy URL"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "submit_spreadsheetPath",
          "label": "Spreadsheet Path",
          "description": "AEM Author spreadsheet path (spreadsheet submit type)",
          "value": "/content/eds-k/test/form"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ui_submitLabel",
          "label": "Submit Button Label",
          "value": "Submit"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ui_successMessage",
          "label": "Success Message",
          "value": "Thank you. Your enquiry has been submitted."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ui_errorMessage",
          "label": "Error Message",
          "value": "Sorry, something went wrong. Please try again."
        }
      ]
    },
    {
      "id": "form-field",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field Type",
          "value": "text",
          "options": [
            { "name": "Text", "value": "text" },
            { "name": "Email", "value": "email" },
            { "name": "Telephone", "value": "tel" },
            { "name": "Textarea", "value": "textarea" },
            { "name": "Radio", "value": "radio" },
            { "name": "Checkbox", "value": "checkbox" },
            { "name": "Dropdown", "value": "select" },
            { "name": "Date", "value": "date" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "name",
          "label": "Name",
          "description": "Field name in the payload; for spreadsheet submit must match the column header",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "required": true
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "options",
          "label": "Options / Settings",
          "description": "Optional lines: required | placeholder: text | help: text. Then one option per line for radio, checkbox, or select (value|Label or Label)."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "form",
      "components": [
        "form-field"
      ]
    }
  ]
}
